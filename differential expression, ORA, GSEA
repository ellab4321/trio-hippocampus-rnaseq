#### Model WT vs. HET at each age ####

x$samples$group <- interaction(x$samples$genotype, x$samples$age, sep= ".")
MODEL <- model.matrix(~0 + group + sex + batch + SV1 + SV2 + SV3 + SV4 + SV5 + SV6 + SV7 + SV8 + SV9, data = x$samples)

contr.matrix <- makeContrasts(
  HETvsWT_age0  = groupHET.0  - groupWT.0,
  HETvsWT_age7  = groupHET.7  - groupWT.7,
  HETvsWT_age35 = groupHET.35 - groupWT.35,
  levels = colnames(MODEL)
)
levels(x$samples$genotype)
v   <- voom(x, MODEL)
vfit <- lmFit(v, MODEL)
vfit <- contrasts.fit(vfit, contrasts=contr.matrix)
efit <- eBayes(vfit)
summary(decideTests(efit))

p0triosynaptosome <- topTable(efit, coef = "HETvsWT_age0", p.value = 0.05, lfc = 0) # 2 downregulated, 1 upregulated
p7triosynaptosome <- topTable(efit, coef = "HETvsWT_age7", p.value = 0.05, lfc = 0) # 2 downregulated
p35triosynaptosomes <- topTable(efit, coef = "HETvsWT_age35", p.value = 0.05, lfc = 0) # 14 downregulated, 72 upregulated

