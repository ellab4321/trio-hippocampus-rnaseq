#### Correlation tests between metadata variables and principal components ####

meta <- x$samples
meta$scode[meta$sex=="M"] <- 1
meta$scode[meta$sex=="F"] <- 2

stopifnot(rownames(pcs) == rownames(meta))

meta$age <- as.numeric(meta$age)
meta$batch <- as.numeric(meta$batch)

cor.test(pcs[,1], meta$age)
cor.test(pcs[,2], meta$age) # Principal components 1 and 2 correlate with age (particularly component 1)

cor.test(pcs[,1], meta$batch)
cor.test(pcs[,2], meta$batch) # Principal components 1 and 2 do not correlate with batch

cor.test(pcs[,3], meta$batch) # Principal component 3 correlates with batch, not when filtered for pc genes

cor.test(pcs[,1], meta$scode) # Principal components do not correlate with sex
cor.test(pcs[,2], meta$scode)
cor.test(pcs[,3], meta$scode)
cor.test(pcs[,4], meta$scode) # Principal component 4 correlates with sex when filtered for pc genes
vars <- c("genotype", "scode", "batch", "age")

results <- lapply(1:5, function(pc) {
  sapply(vars, function(v) {
    if (is.numeric(meta[[v]])) {
      cor.test(pcs[,pc], meta[[v]])$p.value
    } else {
      summary(aov(pcs[,pc] ~ meta[[v]]))[[1]][["Pr(>F)"]][1]
    }
  })
})

pc_assoc <- do.call(rbind, results)
rownames(pc_assoc) <- paste0("PC", 1:5)
pc_assoc

